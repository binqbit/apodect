# A public hostname with DNS pointing to this server; Caddy manages HTTPS.
SITE_ADDRESS=apodect.example.com
# Deployment addresses, provider configuration and dedicated gas-payer credentials.
APODECT_NEAR_RELAYER_ACCOUNT=relayer.example.near
APODECT_SOLANA_CLUSTER=mainnet
APODECT_DEPLOYMENT_FILE=./.secrets/deployment.json
# Plain hexadecimal private key.
APODECT_ETHEREUM_RELAYER_FILE=./.secrets/ethereum-relayer.key
# Standard Solana CLI keypair JSON array.
APODECT_SOLANA_RELAYER_FILE=./.secrets/solana-relayer.json
# NEAR signer JSON: account_id, public_key, private_key (ed25519:...).
# account_id must match APODECT_NEAR_RELAYER_ACCOUNT above.
APODECT_NEAR_RELAYER_FILE=./.secrets/near-relayer.json
# Soft transport-fee warning; it does not reduce principal or block affordable plans.
APODECT_FEE_WARNING_BPS=500
